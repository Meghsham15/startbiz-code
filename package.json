{
  "name": "start-biz",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.30.4",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "start": "node scripts/seo-build.cjs && react-scripts start",
    "build": "react-scripts build && node scripts/strip-redirects.js && node scripts/seo-build.cjs",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "seo": "node scripts/seo-build.cjs",
    "deploy": "node scripts/deploy-pages.cjs",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.150.0"
  }
